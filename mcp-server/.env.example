# Copy this file to .env and fill in real values.
# This file (.env.example) contains placeholders only and is safe to commit.
# The real .env MUST stay out of git (see .gitignore).

# ------------------------------------------------------------------
# OpenShift (in-house cluster)
# ------------------------------------------------------------------
# Route of the cluster's internal OAuth server, usually:
#   https://oauth-openshift.apps.<cluster-domain>
OPENSHIFT_OAUTH_URL=https://oauth-openshift.apps.ocp-new-dev.bri.co.id
# Kubernetes API server route for this cluster
OPENSHIFT_API_URL=https://api.ocp-new-dev.bri.co.id:6443
# Set to false ONLY if the cluster uses a self-signed/internal CA you haven't trusted locally.
# Prefer setting OPENSHIFT_CA_BUNDLE_PATH instead of disabling verification.
OPENSHIFT_TLS_VERIFY=true
# OPENSHIFT_CA_BUNDLE_PATH=/path/to/internal-ca.pem
OPENSHIFT_TOKEN_TTL_SECONDS=1800
# Default credentials for the automated "/get-token-oc" re-authentication flow.
# These let the WhatsApp bot re-generate a token on request without asking for a password
# every time. Keep this .env file out of git and restrict its file permissions (chmod 600).
OPENSHIFT_USERNAME=<isi-username>
OPENSHIFT_PASSWORD=<isi-password>

# ------------------------------------------------------------------
# Jira (Server/Data Center or Cloud)
# ------------------------------------------------------------------
JIRA_BASE_URL=https://jira.bri.co.id/login.jsp?permissionViolation=true&native_login=
# "bearer" = Personal Access Token, "basic" = username/password
# JIRA_AUTH_MODE=bearer
# JIRA_TOKEN=
JIRA_USERNAME=<isi-username>
JIRA_PASSWORD=<isi-password>
JIRA_TLS_VERIFY=true

# ------------------------------------------------------------------
# Bitbucket Server/Data Center
# ------------------------------------------------------------------
BITBUCKET_BASE_URL=https://bitbucket.bri.co.id/login
# BITBUCKET_AUTH_MODE=bearer
# BITBUCKET_TOKEN=
BITBUCKET_USERNAME=<isi-username>
BITBUCKET_PASSWORD=<isi-password>
BITBUCKET_TLS_VERIFY=true

# ------------------------------------------------------------------
# Bamboo
# ------------------------------------------------------------------
BAMBOO_BASE_URL=https://bamboo.bri.co.id/userlogin!doDefault.action
# BAMBOO_AUTH_MODE=bearer
# BAMBOO_TOKEN=
BAMBOO_USERNAME=<isi-username>
BAMBOO_PASSWORD=<isi-password>
BAMBOO_TLS_VERIFY=true
